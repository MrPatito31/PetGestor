# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copiar a .env y completar con valores reales
# NUNCA subir el .env real a un repositorio público
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos MySQL (usado por Docker) ────────────────────────────────────
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=petgestor_db
MYSQL_USER=petgestor_user
MYSQL_PASSWORD=CAMBIAR_PASSWORD_AQUI
MYSQL_ROOT_PASSWORD=CAMBIAR_ROOT_PASSWORD_AQUI

# ── Si usas SQLite en desarrollo local, descomentar: ─────────────────────────
# DATABASE_URL=sqlite:///petgestor_dev.db

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=CAMBIAR_POR_CLAVE_ALEATORIA_LARGA

# ── Twilio (WhatsApp API) ─────────────────────────────────────────────────────
# Obtener en: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Peluquería (datos del negocio) ───────────────────────────────────────────
NEGOCIO_NOMBRE=PetGestor Peluquería Canina
NEGOCIO_TELEFONO=+56912345678
NEGOCIO_DIRECCION=Melipilla, Región Metropolitana, Chile
